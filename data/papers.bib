@article{journalArticle:argyropoulosFacilityLocalRemote1983,
  title = {A {{Facility}} for {{Local}} and {{Remote Acquisition}} and {{Data Process Control}} in {{Metallurgy}}},
  author = {Argyropoulos, Stavros A. and Valiveti, Radhakrishna S. and Closset, Bernard M.},
  date = {1983-10-01},
  journaltitle = {Journal of Metals},
  volume = {35},
  number = {10},
  pages = {30--35},
  issn = {1543-1851},
  doi = {10.1007/BF03338387},
  url = {https://doi.org/10.1007/BF03338387},
  abstract = {Accurate measurement and control for low-level transducer signals in metallurgical industry or laboratory is a complicated process. Until now, no measurement and control system was working truly at optimum cost and performance for a relatively small number of channels. A facility for remote and local data acquisition and process control applications in harsh metallurgical environments is presented in this paper. The system consists of a satellite microperipheral for interfacing between the “real world” and a host microcomputer. The satellite can operate far away from the host. Software and hardware aspects of this facility are presented. Metallurgical applications in four research projects ranging from laboratory tests to plant-scale tests are discussed.}
}

